`timescale 1ns/1ps

module johnson_counter_tb;

reg clk;
reg rst;
wire [3:0] q;

johnson_counter uut (
    .clk(clk),
    .rst(rst),
    .q(q)
);

always #5 clk = ~clk;

initial begin
    clk = 0;
    rst = 1;

    #10 rst = 0;

    #100 $finish;
end

initial begin
    $monitor("Time=%0t Q=%b", $time, q);
end

endmodule